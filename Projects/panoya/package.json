{
  "name": "panoya",
  "version": "1.0.0",
  "private": true,
  "description": "Panoya – akademik işe alım deneyi platformu",
  "scripts": {
    "dev": "next dev -p 3000",
    "build": "next build",
    "start": "next start -p 3000",
    "db:migrate": "tsx scripts/migrate.ts",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "e2e": "playwright test --trace off",
    "vercel-build": "tsx scripts/migrate.ts && next build"
  },
  "dependencies": {
    "exceljs": "4.4.0",
    "next": "15.5.29",
    "pg": "8.13.1",
    "react": "19.1.1",
    "react-dom": "19.1.1",
    "server-only": "0.0.1",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@playwright/test": "1.63.0",
    "@tailwindcss/postcss": "4.1.13",
    "@types/node": "22.15.30",
    "@types/pg": "8.11.10",
    "@types/react": "19.1.12",
    "@types/react-dom": "19.1.9",
    "tailwindcss": "4.1.13",
    "tsx": "4.20.5",
    "typescript": "5.9.2",
    "vitest": "3.2.4"
  },
  "engines": {
    "node": ">=20"
  }
}

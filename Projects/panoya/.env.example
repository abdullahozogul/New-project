# PostgreSQL veya Supabase bağlantı adresi
DATABASE_URL=postgres://panoya:panoya@localhost:5432/panoya
# Araştırmacı paneli parolası (zorunlu, en az 12 karakter)
ADMIN_PASSWORD=degistirin-uzun-bir-parola
# Oturum çerezini imzalamak için rastgele uzun bir dize (en az 32 karakter)
SESSION_SECRET=degistirin-en-az-32-karakterlik-rastgele-bir-dize
